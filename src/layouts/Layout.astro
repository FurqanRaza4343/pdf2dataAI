---
export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  noindex?: boolean;
  breadcrumbs?: { name: string; url: string }[];
}
const {
  title = "DocDataEntry — AI Document Data Entry & Extraction with Confidence Scoring",
  description = "Free AI-powered document data entry tool. Extract invoices, receipts, and forms with per-field confidence scoring. Smart document processing for accountants and small businesses. Try now.",
  canonical = "https://docdataentry.com",
  noindex = false,
  breadcrumbs,
} = Astro.props;
const keywords = "intelligent document processing, automated document processing, AI document processing, intelligent document processing software, document processing, intelligent document processing platform, AI document data entry, document data extraction, invoice data extraction, receipt scanner AI, automated data entry, document scanner AI, PDF data extraction, invoice OCR, document entry software, document analyzer AI, free AI document analysis, document analyzer online free";
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/icon.png" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0a0a0a" />
    <meta name="keywords" content={keywords} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    <meta name="author" content="DocDataEntry" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="DocDataEntry" />
    <meta property="og:image" content="https://docdataentry.com/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://docdataentry.com/og-image.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <script type="application/ld+json">{JSON.stringify({"@context":"https://schema.org","@type":"Organization","name":"DocDataEntry","url":"https://docdataentry.com","description":"AI-powered document data entry with per-field confidence scoring","foundingDate":"2025"})}</script>
    {breadcrumbs && breadcrumbs.length > 0 && (
      <script type="application/ld+json">{JSON.stringify({"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":breadcrumbs.map((b, i) => ({"@type":"ListItem","position":i+1,"name":b.name,"item":b.url}))})}</script>
    )}
  </head>
  <body>
    <slot />
  </body>
</html>
