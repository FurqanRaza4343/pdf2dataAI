---
export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  noindex?: boolean;
}
const {
  title = "PDF to Excel AI — AI Document Extraction & Data Converter",
  description = "Free AI-powered PDF to Excel converter. Extract tables, invoices, receipts & forms with confidence scoring. Smart document scanner with automated data extraction. Try now.",
  canonical = "https://pdf2dataai.com",
  noindex = false,
} = Astro.props;
const keywords = "PDF to Excel AI, AI invoice extractor, automated receipt processing, PDF data extraction, smart document scanner, PDF to Excel converter, AI document extraction, receipt scanning AI, invoice data extraction, PDF table extraction";
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/icon.png" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0a0a0a" />
    <meta name="keywords" content={keywords} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    <meta name="author" content="PDF2DataAI" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="PDF2DataAI" />
    <meta property="og:image" content="https://pdf2dataai.com/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://pdf2dataai.com/og-image.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <slot />
  </body>
</html>
