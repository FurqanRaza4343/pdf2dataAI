---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Contact Us — AI Document Data Entry Support | DocDataEntry" description="Get in touch with the DocDataEntry team. Contact us for support, partnerships, or any questions about our AI document data entry service." canonical="https://docdataentry.com/contact" breadcrumbs={[{name:"Home",url:"https://docdataentry.com"},{name:"Contact",url:"https://docdataentry.com/contact"}]}>
  <Nav />
  <main class="pt-24">
    <section class="mx-auto max-w-3xl px-6 py-20">
      <span class="mb-6 inline-block text-xs font-semibold uppercase tracking-widest text-brand-400">Contact</span>
      <h1 class="mb-4 text-4xl font-bold tracking-tight">Get in touch</h1>
      <p class="mb-12 text-lg text-neutral-400">Have questions about our AI document extraction? We'd love to hear from you.</p>

      <div class="mb-12 grid gap-6 sm:grid-cols-3">
        <div class="rounded-xl border border-neutral-800 bg-neutral-900/30 p-6 text-center">
          <div class="mx-auto mb-3 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-500/10 text-brand-400">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          </div>
          <h3 class="mb-1 font-semibold">Email</h3>
          <p class="text-sm text-neutral-400">support@docdataentry.com</p>
        </div>

        <div class="rounded-xl border border-neutral-800 bg-neutral-900/30 p-6 text-center">
          <div class="mx-auto mb-3 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-500/10 text-brand-400">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          </div>
          <h3 class="mb-1 font-semibold">Location</h3>
          <p class="text-sm text-neutral-400">San Francisco, CA</p>
        </div>

        <div class="rounded-xl border border-neutral-800 bg-neutral-900/30 p-6 text-center">
          <div class="mx-auto mb-3 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-500/10 text-brand-400">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
          <h3 class="mb-1 font-semibold">Response time</h3>
          <p class="text-sm text-neutral-400">24-48 hours</p>
        </div>
      </div>

      <div class="rounded-2xl border border-neutral-800 bg-neutral-900/30 p-8">
        <h2 class="mb-6 text-xl font-bold">Send us a message</h2>
        <form class="space-y-5">
          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label for="name" class="mb-1.5 block text-sm font-medium text-neutral-400">Name</label>
              <input type="text" id="name" class="w-full rounded-xl border border-neutral-800 bg-neutral-950 px-4 py-3 text-sm text-neutral-200 placeholder-neutral-600 transition-all focus:border-brand-500/50 focus:outline-none focus:ring-1 focus:ring-brand-500/30" placeholder="Your name" />
            </div>
            <div>
              <label for="email" class="mb-1.5 block text-sm font-medium text-neutral-400">Email</label>
              <input type="email" id="email" class="w-full rounded-xl border border-neutral-800 bg-neutral-950 px-4 py-3 text-sm text-neutral-200 placeholder-neutral-600 transition-all focus:border-brand-500/50 focus:outline-none focus:ring-1 focus:ring-brand-500/30" placeholder="you@example.com" />
            </div>
          </div>
          <div>
            <label for="message" class="mb-1.5 block text-sm font-medium text-neutral-400">Message</label>
            <textarea id="message" rows="5" class="w-full rounded-xl border border-neutral-800 bg-neutral-950 px-4 py-3 text-sm text-neutral-200 placeholder-neutral-600 transition-all focus:border-brand-500/50 focus:outline-none focus:ring-1 focus:ring-brand-500/30" placeholder="Tell us how we can help..."></textarea>
          </div>
          <button type="submit" class="inline-flex items-center gap-2 rounded-xl bg-brand-500 px-8 py-3 text-sm font-semibold text-white shadow-lg shadow-brand-500/25 transition-all hover:bg-brand-600">
            Send message
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
          </button>
        </form>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
