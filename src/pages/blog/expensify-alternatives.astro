              <tr><td class="px-4 py-3">Free tier</td><td class="px-4 py-3 text-emerald-400">Yes</td><td class="px-4 py-3 text-amber-400">Limited</td><td class="px-4 py-3 text-neutral-600">No</td><td class="px-4 py-3 text-neutral-600">No</td></tr>
              <tr><td class="px-4 py-3">Excel/CSV/JSON export</td><td class="px-4 py-3 text-emerald-400">Yes</td><td class="px-4 py-3 text-emerald-400">Yes</td><td class="px-4 py-3 text-emerald-400">Yes</td><td class="px-4 py-3 text-emerald-400">Yes</td></tr>
              <tr><td class="px-4 py-3">Transparent pricing</td><td class="px-4 py-3 text-emerald-400">Yes</td><td class="px-4 py-3 text-neutral-600">No</td><td class="px-4 py-3 text-amber-400">Partial</td><td class="px-4 py-3 text-neutral-600">No</td></tr>
