---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Dashboard — AI Document Data Entry | DocDataEntry" description="Review your AI-extracted documents, approve flagged fields, and export results. Manage all your document data entry in one place." canonical="https://docdataentry.com/dashboard" breadcrumbs={[{name:"Home",url:"https://docdataentry.com"},{name:"Dashboard",url:"https://docdataentry.com/dashboard"}]}>
  <Nav />
  <main class="pt-24">
    <div class="mx-auto max-w-6xl px-6 py-16">
      <div class="mb-10 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <h1 class="text-3xl font-bold tracking-tight">Documents</h1>
          <p class="mt-1 text-neutral-400">Review extracted data, approve flagged fields, and export results.</p>
        </div>
        <a href="/upload" class="inline-flex items-center gap-2 rounded-xl bg-brand-500 px-5 py-3 text-sm font-semibold text-white shadow-lg shadow-brand-500/25 transition-all hover:bg-brand-600">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
          Upload new
        </a>
      </div>

      <div id="empty-state" class="rounded-2xl border border-neutral-800 bg-neutral-900/30 p-16 text-center">
        <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-2xl bg-neutral-800">
          <svg class="h-8 w-8 text-neutral-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
        </div>
        <h2 class="text-xl font-semibold">No documents yet</h2>
        <p class="mt-2 text-neutral-400">Upload your first document to start extracting data.</p>
        <a href="/upload" class="mt-6 inline-flex items-center gap-2 rounded-xl bg-neutral-100 px-6 py-3 text-sm font-semibold text-neutral-950 transition-all hover:bg-neutral-200">
          Upload document
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
        </a>
      </div>

      <div id="documents-list" class="hidden space-y-3"></div>
    </div>
  </main>
  <Footer />

  <script src="/src/scripts/store.js"></script>
  <script src="/src/scripts/dashboard.js"></script>
</Layout>
