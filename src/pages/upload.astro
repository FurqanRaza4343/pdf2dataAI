---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Upload Document — Free AI Document Data Entry | DocDataEntry" description="Upload your PDF, image, or document for AI-powered data extraction with per-field confidence scoring. Supports PDF, PNG, JPG, DOCX." canonical="https://docdataentry.com/upload" breadcrumbs={[{name:"Home",url:"https://docdataentry.com"},{name:"Upload",url:"https://docdataentry.com/upload"}]}>
  <Nav />
  <main class="pt-24">
    <div class="mx-auto max-w-3xl px-6 py-16">
      <div class="mb-12 text-center">
        <h1 class="text-4xl font-bold tracking-tight">Upload your document</h1>
        <p class="mt-3 text-lg text-neutral-400">PDF, image, or scanned document. We&rsquo;ll extract the data and score every field.</p>
        <div id="format-badge" class="mt-4 inline-flex items-center gap-2 rounded-full border border-brand-500/20 bg-brand-500/5 px-4 py-1.5 text-sm text-brand-300 opacity-0 transition-opacity"></div>
      </div>

      <div id="drop-zone" class="relative cursor-pointer rounded-2xl border-2 border-dashed border-neutral-700 bg-neutral-900/30 p-8 sm:p-16 text-center transition-all hover:border-brand-500/50 hover:bg-brand-500/[0.02]">
        <input type="file" id="file-input" accept=".pdf,.png,.jpg,.jpeg,.tiff" multiple class="absolute inset-0 cursor-pointer opacity-0" />
        <div id="upload-prompt" class="flex flex-col items-center gap-4">
          <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-brand-500/10 text-brand-400">
            <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"/></svg>
          </div>
          <p class="text-lg font-medium">Drop documents here</p>
          <p class="text-sm text-neutral-500">or click to browse &bull; PDF, PNG, JPG up to 50MB each</p>
        </div>
        <div id="upload-progress" class="hidden flex-col items-center gap-4">
          <p class="text-lg font-medium" id="progress-text">Processing files...</p>
          <div class="h-2 w-full max-w-xs overflow-hidden rounded-full bg-neutral-800">
            <div id="progress-bar" class="h-full w-0 rounded-full bg-brand-500 transition-all duration-500" />
          </div>
        </div>
      </div>

      <div id="file-queue" class="mt-6 hidden space-y-2"></div>

      <div id="batch-done" class="mt-6 hidden text-center">
        <a href="/dashboard" class="inline-flex items-center gap-2 rounded-xl bg-brand-500 px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-brand-500/25 transition-all hover:bg-brand-600">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
          View all in Dashboard
        </a>
      </div>

      <div class="mt-8 grid gap-4 sm:grid-cols-3">
        {[
          { icon: "M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z", text: "Confidence score per field" },
          { icon: "M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z", text: "Auto-flagged below 90%" },
          { icon: "M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z", text: "Export to Excel & CSV" },
        ].map((item) => (
          <div class="flex items-start gap-3 rounded-xl border border-neutral-800 bg-neutral-900/30 p-4">
            <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-brand-500/10 text-brand-400">
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={item.icon}/></svg>
            </div>
            <p class="text-sm text-neutral-400">{item.text}</p>
          </div>
        ))}
      </div>
    </div>
  </main>
  <Footer />
</Layout>

  <script src="/src/scripts/store.js"></script>
  <script src="/src/scripts/upload.js"></script>
